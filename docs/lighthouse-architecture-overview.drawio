<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Architecture" id="architecture"><mxGraphModel dx="1900" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><object id="agents" label="Coding agents" tooltip="Codex and Claude Code start a local Lighthouse command to load relevant context, search stored results, or save new work. The initial CLI supports context loading, search, saves, and constrained code calls."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="110" height="160" as="geometry" /></mxCell></object><object id="operator" label="Local user" tooltip="The local operator uses the dashboard for metrics, audit, search, document edits, and data transfer; agents use the code-call CLI as the primary data interface."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="110" height="160" as="geometry" /></mxCell></object><object id="code" label="Run one bounded code call" tooltip="A coding agent sends a short script to the local executable. The planned runtime batches multiple database operations and returns a bounded result; it has no raw SQL, shell, network, or filesystem capability."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;rounded=1;autosize=1;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="330" height="150" as="geometry" /></mxCell></object><object id="dashboard" label="Inspect saved data and metrics" tooltip="The optional loopback dashboard is manually started and protects user-directed writes with same-origin CSRF checks. It server-renders metrics, search, artifact detail, and memory review; agents use the local code-call CLI as their primary client; dashboard edits are audited."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;rounded=1;autosize=1;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="590" width="330" height="150" as="geometry" /></mxCell></object><object id="services" label="Validate, search, and store" tooltip="Shared Go application services validate captures, search lexical and vector indexes, apply provenance rules, and coordinate transactional writes. The dashboard and code runner use validated store operations; the code runner exposes only bounded typed capabilities."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;rounded=1;autosize=1;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="350" height="160" as="geometry" /></mxCell></object><object id="memory" label="Load and refresh session memory" tooltip="The memory manager builds a compact scope-specific snapshot at chat start. After a relevant write it advances the revision and returns a context patch; the agent host must add that patch to the active conversation."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;rounded=1;autosize=1;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="350" height="160" as="geometry" /></mxCell></object><object id="database" label="Local embedded database" tooltip="One local database file holds source artifacts, curated memory, snapshot revisions, provenance, and indexes. The implementation uses a local SQLite file through the CGo-free modernc driver with an optional bundled sqlite-vec extension."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="1600" y="260" width="190" height="180" as="geometry" /></mxCell></object><object id="embeddings" label="Embedding model (optional)" tooltip="An explicitly configured local embedding model can create vectors for document chunks and queries. The database stores and searches vectors but does not create them. This provider and model are not yet selected or implemented."><mxCell style="whiteSpace=wrap;html=1;sketch=1;fontSize=24;rounded=1;autosize=1;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1600" y="640" width="300" height="145" as="geometry" /></mxCell></object><object id="e1" label="runs code"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="agents" target="code"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e2" label="starts dashboard"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="operator" target="dashboard"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e3" label="calls API"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="code" target="services"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e4" label="uses dashboard"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="dashboard" target="services"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e5" label="loads memory"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="services" target="memory"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e6" label="commits snapshot"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="memory" target="database"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e7" label="reads and writes"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="services" target="database"><mxGeometry relative="1" as="geometry" /></mxCell></object><object id="e8" label="gets embeddings"><mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;sketch=1;html=1;fontSize=24;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="services" target="embeddings"><mxGeometry relative="1" as="geometry" /></mxCell></object></root></mxGraphModel></diagram><diagram name="Notes" id="notes"><mxGraphModel dx="3300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="&lt;b&gt;What it is&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lighthouse is a proposed local-first archive and retrieval layer for coding-agent results. It keeps full source artifacts and prepares compact, source-linked context snapshots for chats. One local executable provides agent commands and an optional manually started dashboard." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=24;align=left;verticalAlign=top;spacing=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="600" height="780" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Who uses it and what they can do&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Paul: inspect metrics, charts, search, and audit in the dashboard; make user-directed edits and transfer data there, while agents use the CLI code call as their primary client.&lt;br&gt;• Codex and Claude Code: load session context, search prior work, run one bounded multi-step code call, and save new results.&lt;br&gt;• Agent access is through the local executable; MCP is explicitly out of scope." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=24;align=left;verticalAlign=top;spacing=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="690" y="40" width="600" height="780" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;How it fits together&lt;/b&gt;&lt;br&gt;&lt;br&gt;The agent loads a scoped snapshot at chat start, then reuses that conversation context. A code call can batch local searches, filters, and writes. Shared Go services validate the call, search text/vector indexes, and commit changes to the local database. Relevant writes advance a memory revision and return a context patch for the agent to add to the active chat." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=24;align=left;verticalAlign=top;spacing=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1340" y="40" width="600" height="780" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Built, stubbed, not built&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Built: Go CLI, SQLite schema and store, lexical search, Starlark code-call runtime, metrics, and a server-rendered dashboard with protected edits and imports/exports.&lt;br&gt;• Not built: embedding provider, automatic startup hooks, daemon installation, and automated startup hooks and restore workflow.&lt;br&gt;• Storage: SQLite through modernc.org/sqlite, with the bundled sqlite-vec extension.&lt;br&gt;• Embedding provider and model remain undecided." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=24;align=left;verticalAlign=top;spacing=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1990" y="40" width="600" height="780" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Where to look (secondary)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Product goals and boundaries: docs/00-product-brief.md&lt;br&gt;• Runtime and database choice: docs/01-architecture.md and docs/06-decisions-and-roadmap.md&lt;br&gt;• Entities and retrieval: docs/02-data-model-and-search.md&lt;br&gt;• Code execution and memory refresh: docs/03-code-call-and-memory.md&lt;br&gt;• Colors, typography, spacing, responsive rules, and exact finish values: docs/04-dashboard-visual-spec.md&lt;br&gt;• Security and local operation: docs/05-security-and-operations.md&lt;br&gt;• Visual source: /Users/iampaulking/projects/duchess/houseofanio/app/globals.css and app/layout.tsx" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fontSize=24;align=left;verticalAlign=top;spacing=16;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2640" y="40" width="600" height="780" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>